# Agent Speaker Relay - Dockerfile
# Based on strfry with AASTAR custom configurations
# 
# Build context should be the root of our forked repository
# Submodules must be initialized locally before building
#
# Build: docker build -f Dockerfile.agent-speaker -t mushroomdao/agent-speaker-relay:latest .
# Run:   docker run -d -p 7777:7777 mushroomdao/agent-speaker-relay:latest

# Alpine-based build (smaller, official approach)
FROM alpine:3.18 AS builder

WORKDIR /build

# Install build dependencies
RUN apk --no-cache add \
    linux-headers \
    git \
    g++ \
    make \
    perl \
    pkgconfig \
    libtool \
    ca-certificates \
    libressl-dev \
    zlib-dev \
    lmdb-dev \
    flatbuffers-dev \
    libsecp256k1-dev \
    zstd-dev

# Copy source from build context (submodules must be initialized locally)
COPY . .

# Build strfry
RUN make -j$(nproc)

# Runtime image
FROM alpine:3.18

WORKDIR /app

# Install runtime dependencies
RUN apk --no-cache add \
    lmdb \
    flatbuffers \
    libsecp256k1 \
    libb2 \
    zstd \
    libressl \
    curl

# Copy binary from builder
COPY --from=builder /build/strfry /usr/local/bin/strfry

# Copy default config
COPY strfry.aastar.conf /app/strfry.conf.default

# Create data directory
RUN mkdir -p /app/strfry-db

# Expose port
EXPOSE 7777

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:7777 || exit 1

# Default command
ENTRYPOINT ["strfry"]
CMD ["--config", "/app/strfry.conf", "relay"]
