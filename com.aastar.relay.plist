<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aastar.relay</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/docker</string>
        <string>compose</string>
        <string>-f</string>
        <string>/Users/aastar/agent-relay/docker-compose.aastar.yml</string>
        <string>up</string>
        <string>-d</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/aastar/agent-relay</string>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/Users/aastar/agent-relay/logs/relay.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/aastar/agent-relay/logs/relay.error.log</string>
    
    <key>ThrottleInterval</key>
    <integer>60</integer>
    
    <!-- Wait for network -->
    <key>NetworkState</key>
    <true/>
</dict>
</plist>
